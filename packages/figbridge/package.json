{
  "name": "figbridge",
  "version": "0.0.0",
  "description": "Let AI agents read and write Figma, and turn PDF/PPTX decks into editable Figma layers.",
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "pptx",
    "pdf",
    "import",
    "figma-plugin"
  ],
  "homepage": "https://github.com/vafaevelshodbek-png/FigBridge#readme",
  "bugs": "https://github.com/vafaevelshodbek-png/FigBridge/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vafaevelshodbek-png/FigBridge.git",
    "directory": "packages/figbridge"
  },
  "license": "MIT",
  "author": "Vafaev Elshodbek (https://github.com/vafaevelshodbek-png)",
  "contributors": [
    "strevesuksess (https://github.com/strevesuksess)"
  ],
  "type": "module",
  "bin": {
    "figbridge": "./dist/cli.mjs"
  },
  "exports": {
    "./web/browser": "./web/browser-capture.mjs",
    "./web/explore": "./web/explore.mjs",
    "./web/capture": "./web/capture-dom.mjs",
    "./web/import": "./web/import-capture.mjs",
    "./web/normalize": "./web/normalize-capture.mjs",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "web",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown && node scripts/bundle-plugin.mjs",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md')\"",
    "postpack": "node -e \"require('node:fs').rmSync('README.md',{force:true})\"",
    "smoke": "node scripts/smoke-install.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "commander": "catalog:",
    "fast-xml-parser": "catalog:",
    "fflate": "catalog:",
    "pdfjs-dist": "catalog:",
    "pino": "catalog:",
    "playwright": "1.65.1",
    "ulid": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@figbridge/import-pdf": "workspace:*",
    "@figbridge/import-pptx": "workspace:*",
    "@figbridge/protocol": "workspace:*",
    "@figbridge/scene": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:"
  }
}
