{
  "name": "figbridge",
  "version": "0.0.0",
  "description": "Let AI agents read and write Figma, and turn PDF/PPTX decks into editable Figma layers.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "figbridge": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@figbridge/import-pdf": "workspace:*",
    "@figbridge/import-pptx": "workspace:*",
    "@figbridge/protocol": "workspace:*",
    "@figbridge/scene": "workspace:*",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "commander": "catalog:",
    "pino": "catalog:",
    "ulid": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/ws": "catalog:",
    "tsdown": "catalog:"
  }
}
