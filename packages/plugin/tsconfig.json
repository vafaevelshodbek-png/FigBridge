{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".tsbuild/src",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // The plugin runs inside Figma: no Node types, so sources cannot reach for Node APIs.
    "types": ["@figma/plugin-typings"]
  },
  "include": ["src"],
  "references": [{ "path": "../protocol" }, { "path": "../scene" }]
}
