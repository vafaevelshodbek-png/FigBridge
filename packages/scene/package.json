{
  "name": "@figbridge/scene",
  "version": "0.0.0",
  "description": "Scene IR: the editable layer tree shared by figbridge importers and the Figma renderer.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "@figbridge/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./render": {
      "@figbridge/source": "./src/render.ts",
      "types": "./dist/render.d.mts",
      "import": "./dist/render.mjs"
    },
    "./path": {
      "@figbridge/source": "./src/path.ts",
      "types": "./dist/path.d.mts",
      "import": "./dist/path.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/render.ts src/path.ts --format esm --dts --clean"
  },
  "dependencies": {
    "zod": "catalog:",
    "@napi-rs/canvas": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:"
  }
}
